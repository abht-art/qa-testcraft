# Copy to .env and fill in. .env is gitignored and blocked from Claude.

# QMetry Open API key, used by /qmetry-push: Jira, QMetry, Configuration, Open API, Generate.
QTM_API_TOKEN=
# QMetry Automation API key, used by scripts/qmetry-import-results.ts:
# Jira, QMetry, Automation & CI/CD, Automation API, Generate. Falls back to QTM_API_TOKEN.
QTM_AUTOMATION_API_KEY=
# Optional. Only for a non-global QMetry region.
# QTM_API_BASE_URL=https://syd-qtmcloud.qmetry.com/rest/api/latest
# QTM_AUTOMATION_BASE_URL=https://syd-qtmcloud.qmetry.com/rest/api/automation
